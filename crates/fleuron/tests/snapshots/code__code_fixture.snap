[
  [
    "text 54.00 72.98 18 \"Reading the manifest\"",
    "text 54.00 90.80 11 \"A manifest names the parts of a build and nothing else. It leaves the\"",
    "text 333.26 90.80 11 \" \"",
    "text 335.46 90.80 11 \"order of the\"",
    "text 54.00 106.20 11 \"parts to the build, and the choice of machine to the\"",
    "text 266.89 106.20 11 \" \"",
    "text 269.09 106.20 11 \"caller. The build reads the\"",
    "text 54.00 121.60 11 \"manifest once, at the start, and holds it\"",
    "text 214.62 121.60 11 \" \"",
    "text 216.82 121.60 11 \"for the rest of the run. A field the build\"",
    "text 54.00 137.00 11 \"does not know is a warning\"",
    "text 167.51 137.00 11 \" \"",
    "text 169.71 137.00 11 \"rather than an error, so a manifest written for a later\"",
    "text 54.00 152.40 11 \"version still\"",
    "text 101.19 152.40 11 \" \"",
    "text 103.39 152.40 11 \"builds.\"",
    "text 67.20 167.80 11 \"The name of a part is the key. The \"",
    "text 210.72 167.80 11 \"source\"",
    "text 237.73 167.80 11 \" field is a path, relative\"",
    "text 329.07 167.80 11 \" \"",
    "text 331.27 167.80 11 \"to the\"",
    "text 54.00 183.20 11 \"manifest, and \"",
    "text 112.66 183.20 11 \"needs\"",
    "text 135.95 183.20 11 \" is a list of the parts that come first. A\"",
    "text 289.87 183.20 11 \" \"",
    "text 292.07 183.20 11 \"part with no \"",
    "text 346.28 183.20 11 \"needs\"",
    "text 54.00 198.60 11 \"is a leaf, and the build starts at the leaves.\"",
    "text 54.00 225.00 11 \"[part.reader]\"",
    "text 54.00 240.40 11 \"source = \\\"src/reader\\\"\"",
    "text 54.00 255.80 11 \"needs = []\"",
    "text 54.00 286.60 11 \"[part.writer]\"",
    "text 54.00 302.00 11 \"source = \\\"src/writer\\\"\"",
    "text 54.00 317.40 11 \"needs = [\\\"reader\\\"]\"",
    "text 54.00 348.20 11 \"[part.driver]\"",
    "text 54.00 363.60 11 \"source = \\\"src/driver\\\"\"",
    "text 54.00 379.00 11 \"needs = [\\\"reader\\\", \\\"writer\\\"]\"",
    "text 54.00 405.40 11 \"The build resolves the manifest into an order and prints it. The\"",
    "text 316.00 405.40 11 \" \"",
    "text 318.20 405.40 11 \"following order\"",
    "text 54.00 420.80 11 \"is what the manifest above resolves to, one part per\"",
    "text 263.84 420.80 11 \" \"",
    "text 266.04 420.80 11 \"line, with the depth of each\"",
    "text 54.00 436.20 11 \"part shown by its indentation:\"",
    "text 54.00 462.60 11 \"reader\"",
    "text 54.00 478.00 11 \"  writer\"",
    "text 54.00 493.40 11 \"    driver\"",
    "text 54.00 519.80 11 \"A cycle between two parts is an error, and the message names both of\"",
    "text 340.18 519.80 11 \" \"",
    "text 342.38 519.80 11 \"them. The\"",
    "text 54.00 535.20 11 \"build stops before it makes anything, so a cycle costs one\"",
    "text 287.67 535.20 11 \" \"",
    "text 289.87 535.20 11 \"read of the manifest\"",
    "text 54.00 550.60 11 \"and nothing else.\""
  ],
  [
    "text 42.00 72.98 18 \"The build script\"",
    "text 42.00 90.80 11 \"The script below is the whole of the build. It reads the manifest,\"",
    "text 307.42 90.80 11 \" \"",
    "text 309.62 90.80 11 \"walks the order,\"",
    "text 42.00 106.20 11 \"and runs one command per part. It keeps the output of\"",
    "text 272.02 106.20 11 \" \"",
    "text 274.22 106.20 11 \"each part in a directory\"",
    "text 42.00 121.60 11 \"of its own, so a part that fails leaves the\"",
    "text 202.35 121.60 11 \" \"",
    "text 204.55 121.60 11 \"parts before it in place. Run it with the\"",
    "text 42.00 137.00 11 \"path to the manifest as its\"",
    "text 147.92 137.00 11 \" \"",
    "text 150.12 137.00 11 \"only argument.\"",
    "text 42.00 163.40 11 \"#!/bin/sh\"",
    "text 42.00 178.80 11 \"set -eu\"",
    "text 42.00 209.60 11 \"manifest=${1:-build.toml}\"",
    "text 42.00 225.00 11 \"out=${OUT:-./out}\"",
    "text 42.00 240.40 11 \"log=$out/build.log\"",
    "text 42.00 271.20 11 \"if [ ! -f \\\"$manifest\\\" ]; then\"",
    "text 42.00 286.60 11 \"    echo \\\"no manifest at $manifest\\\" >&2\"",
    "text 42.00 302.00 11 \"    exit 2\"",
    "text 42.00 317.40 11 \"fi\"",
    "text 42.00 348.20 11 \"mkdir -p \\\"$out\\\"\"",
    "text 42.00 363.60 11 \": > \\\"$log\\\"\"",
    "text 42.00 394.40 11 \"resolve() {\"",
    "text 42.00 409.80 11 \"    # One part per line, deepest last. The reader prints the order\"",
    "text 42.00 425.20 11 \"    # and this reads it back.\"",
    "text 42.00 440.60 11 \"    manifest-reader --order \\\"$manifest\\\"\"",
    "text 42.00 456.00 11 \"}\"",
    "text 42.00 486.80 11 \"make_part() {\"",
    "text 42.00 502.20 11 \"    name=$1\"",
    "text 42.00 517.60 11 \"    source=$2\"",
    "text 42.00 533.00 11 \"    dir=$out/$name\"",
    "text 42.00 563.80 11 \"    if [ -d \\\"$dir\\\" ] && [ -f \\\"$dir/.done\\\" ]; then\"",
    "text 42.00 579.20 11 \"        echo \\\"$name: up to date\\\" | tee -a \\\"$log\\\"\"",
    "text 213.84 624.19 9 \"2\""
  ],
  [
    "text 54.00 65.60 11 \"        return 0\"",
    "text 54.00 81.00 11 \"    fi\"",
    "text 54.00 111.80 11 \"    rm -rf \\\"$dir\\\"\"",
    "text 54.00 127.20 11 \"    mkdir -p \\\"$dir\\\"\"",
    "text 54.00 158.00 11 \"    echo \\\"$name: building\\\" | tee -a \\\"$log\\\"\"",
    "text 54.00 173.40 11 \"    if compile --source \\\"$source\\\" --out \\\"$dir\\\" >>\\\"$log\\\" 2>&1; then\"",
    "text 54.00 188.80 11 \"        touch \\\"$dir/.done\\\"\"",
    "text 54.00 204.20 11 \"        echo \\\"$name: ok\\\" | tee -a \\\"$log\\\"\"",
    "text 54.00 219.60 11 \"    else\"",
    "text 54.00 235.00 11 \"        echo \\\"$name: failed, see $log\\\" >&2\"",
    "text 54.00 250.40 11 \"        return 1\"",
    "text 54.00 265.80 11 \"    fi\"",
    "text 54.00 281.20 11 \"}\"",
    "text 54.00 312.00 11 \"failed=0\"",
    "text 54.00 327.40 11 \"resolve | while read -r name source; do\"",
    "text 54.00 342.80 11 \"    make_part \\\"$name\\\" \\\"$source\\\" || failed=1\"",
    "text 54.00 358.20 11 \"done\"",
    "text 54.00 389.00 11 \"if [ \\\"$failed\\\" -ne 0 ]; then\"",
    "text 54.00 404.40 11 \"    echo \\\"the build stopped at a part that failed\\\" >&2\"",
    "text 54.00 419.80 11 \"    exit 1\"",
    "text 54.00 435.20 11 \"fi\"",
    "text 54.00 466.00 11 \"echo \\\"all parts built into $out\\\" | tee -a \\\"$log\\\"\"",
    "text 54.00 492.40 11 \"The script writes one line per part, and the same line goes to the log.\"",
    "text 336.08 492.40 11 \" \"",
    "text 338.28 492.40 11 \"A part that\"",
    "text 54.00 507.80 11 \"is already made prints \"",
    "text 146.51 507.80 11 \"up to date\"",
    "text 189.01 507.80 11 \" and is left alone, so a\"",
    "text 276.60 507.80 11 \" \"",
    "text 278.80 507.80 11 \"second run of the script\"",
    "text 54.00 523.20 11 \"over the same manifest makes nothing.\"",
    "text 213.84 624.19 9 \"3\""
  ]
]
