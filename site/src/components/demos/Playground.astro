---
/**
 * The split view, mounted: the manuscript, the stylesheet and the
 * page the two make, side by side.
 *
 * The island hydrates on sight and fetches the engine itself. What
 * the server sends is the poster, a real page painted by the engine
 * at build time, so the slot is a typeset page from the first paint
 * and stays one if the script never runs.
 *
 * `not-content` is what keeps a demo out of Starlight's prose
 * styling. A page of chrome inside the markdown body inherits a
 * reading line-height and a margin between every pair of siblings,
 * which is right for prose and wrong for a toolbar.
 */
import '../../styles/demos.css';
import { demo } from '../../demos/catalogue.mjs';
import { poster } from '../../demos/posters.mjs';
import { Playground } from './Playground';

interface Props {
  /** Which demo's manuscript and stylesheet to open with. */
  demo?: string;
  /** Which editors are on screen: `markdown`, `css`, or both. */
  editors?: 'markdown' | 'css' | 'both';
  /** The page to open on, counting from 1. */
  page?: number;
  /** What the display structure is drawn as over the page it made. */
  highlight?: string;
  /** Whether the warnings are open to begin with. */
  warnings?: boolean;
  /** What the demo is, in one line, under it. */
  caption?: string;
}

const {
  demo: id = 'playground',
  editors = 'both',
  page,
  highlight,
  warnings = false,
  caption,
} = Astro.props;
const inputs = demo(id);
---

<div class="not-content">
  <Playground
    client:visible
    id={id}
    markdown={inputs.markdown}
    css={inputs.css}
    name={inputs.name}
    dialect={inputs.dialect}
    images={inputs.images}
    fonts={inputs.fonts}
    editors={editors}
    page={page ?? inputs.page}
    highlight={highlight}
    warnings={warnings}
    caption={caption}
  >
    <Fragment set:html={poster(id)} />
  </Playground>
</div>
