---
// The engine's own output: page 1 of fixtures/book.json under
// fixtures/styled.css, one <text> per run with the display list's
// per-glyph positions. The browser does no shaping of its own, which
// is why the x-lists are absolute and kerning is off.
import page from '../assets/hero-page.svg?raw';
---

<figure class="paper">
  <div class="sheet" set:html={page} />
  <figcaption>
    <span class="f-mark" aria-hidden="true">&#10086;</span>
    Page 1 of the sample book, typeset by fleuron. The preview and the PDF
    are painted from the same layout.
  </figcaption>
</figure>

<style>
  .paper {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  /* The one bright, square-cornered object on the page. Every other
     surface here is dark glass with a generous radius. */
  .sheet {
    width: min(100%, 25rem);
    background: var(--f-paper);
    color: var(--f-paper-ink);
    border-radius: 0;
    box-shadow:
      0 0 0 1px var(--f-paper-edge),
      0 30px 70px -20px rgb(0 0 0 / 0.65),
      0 8px 24px -12px rgb(0 0 0 / 0.5);
  }

  .sheet :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    max-width: 26rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--f-text-muted);
    text-align: center;
  }

  figcaption .f-mark {
    margin-inline-end: 0.35em;
  }
</style>
