---
// The pipeline is one-way, and the drawing says so: nothing points
// up. Text is <text>, not paths, so it stays selectable and scales
// with the reader's font settings.
const W = 180;
const H = 38;
const LEFT = 150;
const MID = 280;
const RIGHT = 410;

// A step is one beat of the loop. A wire runs on the beat before the
// node it ends at, so the node lights as the pulse arrives.
const nodes = [
  { label: 'markdown', cx: LEFT, y: 10, step: 0 },
  { label: 'CSS', cx: RIGHT, y: 10, step: 2 },
  { label: 'content tree', cx: LEFT, y: 72, step: 2 },
  { label: 'style tree', cx: MID, y: 150, step: 4 },
  { label: 'box tree', cx: MID, y: 212, step: 6 },
  { label: 'line layout', cx: MID, y: 274, step: 8 },
  { label: 'fragmentation', cx: MID, y: 336, step: 10 },
  { label: 'pages', cx: MID, y: 398, step: 12 },
  { label: 'display structure', cx: LEFT, y: 476, step: 14, out: 'preview' },
  { label: 'PDF', cx: RIGHT, y: 476, step: 14, out: 'export' },
];

const HEAD = 8;

/** A wire through the given points, stopping short of the arrowhead at its tip. */
function wire(step: number, points: [number, number][]) {
  const [tx, ty] = points[points.length - 1]!;
  const stops = [...points.slice(0, -1), [tx, ty - HEAD + 1]];
  return {
    step,
    d: stops.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x} ${y}`).join(' '),
    head: `${tx - 6},${ty - HEAD} ${tx + 6},${ty - HEAD} ${tx},${ty}`,
  };
}

const wires = [
  wire(1, [[LEFT, 48], [LEFT, 72]]),
  wire(3, [[LEFT, 110], [LEFT, 130], [MID, 130], [MID, 150]]),
  wire(3, [[RIGHT, 48], [RIGHT, 130], [MID, 130], [MID, 150]]),
  wire(5, [[MID, 188], [MID, 212]]),
  wire(7, [[MID, 250], [MID, 274]]),
  wire(9, [[MID, 312], [MID, 336]]),
  wire(11, [[MID, 374], [MID, 398]]),
  wire(13, [[MID, 436], [MID, 456], [LEFT, 456], [LEFT, 476]]),
  wire(13, [[MID, 436], [MID, 456], [RIGHT, 456], [RIGHT, 476]]),
];
---

<figure class="not-content pipeline">
  <svg viewBox="52 0 462 548" role="img" aria-labelledby="pipeline-title">
    <title id="pipeline-title">
      Markdown becomes a content tree. The content tree and the CSS make
      the style tree. The box tree, line layout, fragmentation, and pages
      follow in order. The pages leave as a display structure for preview
      and as a PDF for export.
    </title>

    {
      wires.map((w) => (
        <g class="wire" style={`--step: ${w.step}`}>
          <path d={w.d} />
          <path class="pulse" d={w.d} pathLength="1" />
          <polygon points={w.head} />
        </g>
      ))
    }

    {
      nodes.map((n) => (
        <g class:list={['node', { out: n.out }]} style={`--step: ${n.step}`}>
          <rect class="plate" x={n.cx - W / 2 + 6} y={n.y + 6} width={W} height={H} />
          <rect class="face" x={n.cx - W / 2} y={n.y} width={W} height={H} />
          <text x={n.cx} y={n.y + H / 2 + 4.5}>{n.label}</text>
          {n.out && (
            <text class="role" x={n.cx} y={n.y + H + 26}>
              {n.out}
            </text>
          )}
        </g>
      ))
    }
  </svg>
</figure>

<style>
  .pipeline {
    --beat: 0.42s;
    /* Seventeen beats: fifteen steps and a rest before the loop. The
       keyframe percentages below are fractions of this. */
    --cycle: calc(var(--beat) * 17);
    margin: 1.5rem 0;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 29rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .face {
    fill: var(--f-panel);
    stroke: var(--f-rule);
    stroke-width: 3;
  }

  .plate {
    fill: var(--f-ink-c);
    opacity: 0;
  }

  .out .face {
    fill: var(--f-hi);
  }

  text {
    fill: var(--f-panel-ink);
    font-family: var(--f-chrome);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-anchor: middle;
  }

  .out text {
    fill: var(--f-hi-ink);
  }

  text.role {
    fill: var(--f-ink-2);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .wire path {
    fill: none;
    stroke: var(--f-rule);
    stroke-width: 3;
  }

  .wire polygon {
    fill: var(--f-rule);
  }

  .wire .pulse {
    stroke: var(--f-ink-m);
    stroke-width: 5;
    stroke-dasharray: 0.45 1;
    stroke-dashoffset: 0.45;
  }

  /* The beats switch rather than fade. A label halfway between its
     two colors on a face halfway between its two is unreadable. */
  @media (prefers-reduced-motion: no-preference) {
    .wire .pulse,
    .wire polygon,
    .node .face,
    .node .plate,
    .node text:not(.role) {
      animation: var(--cycle) step-end infinite;
      animation-delay: calc(var(--step) * var(--beat));
    }

    .wire .pulse {
      animation-name: pipeline-run;
      animation-timing-function: linear;
    }

    .wire polygon {
      animation-name: pipeline-tip;
    }

    .node .face {
      animation-name: pipeline-face;
    }

    .node .plate {
      animation-name: pipeline-plate;
    }

    .node text:not(.role) {
      animation-name: pipeline-label;
    }
  }

  /* One beat is 5.88% of the cycle. */
  @keyframes pipeline-run {
    0% {
      stroke-dashoffset: 0.45;
    }
    5.88%,
    100% {
      stroke-dashoffset: -1;
    }
  }

  @keyframes pipeline-tip {
    0%,
    100% {
      fill: var(--f-rule);
    }
    4.5% {
      fill: var(--f-ink-m);
    }
    8% {
      fill: var(--f-rule);
    }
  }

  @keyframes pipeline-face {
    0% {
      fill: var(--f-hi);
    }
    13%,
    100% {
      fill: var(--f-panel);
    }
  }

  @keyframes pipeline-label {
    0% {
      fill: var(--f-hi-ink);
    }
    13%,
    100% {
      fill: var(--f-panel-ink);
    }
  }

  @keyframes pipeline-plate {
    0% {
      opacity: 1;
    }
    13%,
    100% {
      opacity: 0;
    }
  }

  /* The outputs are yellow at rest, so only the plate marks the beat. */
  .out .face,
  .out text:not(.role) {
    animation-name: none;
  }
</style>
