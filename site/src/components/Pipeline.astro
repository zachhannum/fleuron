---
// The pipeline is one-way, and the drawing says so: nothing points
// left. Text is <text>, not paths, so it stays selectable and scales
// with the reader's font settings.
const stages = [
  { x: 372, label: 'style tree' },
  { x: 492, label: 'box tree' },
  { x: 612, label: 'line layout' },
  { x: 744, label: 'fragmentation' },
  { x: 884, label: 'pages' },
];
---

<div class="scroller">
  <svg viewBox="0 0 1120 200" role="img" aria-labelledby="pipeline-title">
    <title id="pipeline-title">
      Markdown becomes a content tree; that and CSS enter; style tree,
      box tree, line layout, fragmentation and pages follow in order;
      pages leave as a display list for preview and a PDF for export.
    </title>

    <g class="node">
      <rect x="8" y="34" width="118" height="34" rx="8"></rect>
      <text x="67" y="56">markdown</text>
    </g>
    <path class="wire" d="M126 51 H166"></path>
    <g class="node">
      <rect x="166" y="34" width="132" height="34" rx="8"></rect>
      <text x="232" y="56">content tree</text>
    </g>
    <g class="node">
      <rect x="8" y="112" width="132" height="34" rx="8"></rect>
      <text x="74" y="134">CSS</text>
    </g>

    <path class="wire" d="M298 51 H328 Q336 51 336 59 V82 Q336 90 344 90 H364"></path>
    <path class="wire" d="M140 129 H328 Q336 129 336 121 V98 Q336 90 344 90 H364"></path>

    {
      stages.map((stage, i) => (
        <g class="node">
          <rect x={stage.x} y={73} width={stage.label.length * 7.6 + 30} height={34} rx={8} />
          <text x={stage.x + (stage.label.length * 7.6 + 30) / 2} y={95}>
            {stage.label}
          </text>
          {i < stages.length - 1 && (
            <path
              class="wire"
              d={`M${stage.x + stage.label.length * 7.6 + 30} 90 H${stages[i + 1]!.x - 6}`}
            />
          )}
        </g>
      ))
    }

    <path class="wire" d="M968 90 H1000 Q1008 90 1008 82 V48 Q1008 40 1016 40 H1036"></path>
    <path class="wire" d="M968 90 H1000 Q1008 90 1008 98 V132 Q1008 140 1016 140 H1036"></path>

    <g class="node out">
      <rect x="976" y="23" width="136" height="34" rx="8"></rect>
      <text x="1044" y="45">display list</text>
    </g>
    <g class="node out">
      <rect x="976" y="123" width="136" height="34" rx="8"></rect>
      <text x="1044" y="145">PDF</text>
    </g>
  </svg>
</div>

<style>
  .scroller {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  svg {
    display: block;
    min-width: 54rem;
    width: 100%;
    height: auto;
  }

  .node rect {
    fill: var(--f-glass-solid);
    stroke: var(--f-hairline-strong);
    stroke-width: 1;
  }

  .node.out rect {
    stroke: color-mix(in oklab, var(--f-accent) 55%, transparent);
  }

  .node text {
    fill: var(--f-text);
    font-family: var(--f-mono);
    font-size: 13px;
    text-anchor: middle;
  }

  .wire {
    fill: none;
    stroke: var(--f-hairline-strong);
    stroke-width: 1.25;
  }
</style>
