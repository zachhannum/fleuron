---
// The pipeline is one-way, and the drawing says so: nothing points
// left. Text is <text>, not paths, so it stays selectable and scales
// with the reader's font settings.
const stages = [
  { x: 232, label: 'style tree' },
  { x: 352, label: 'box tree' },
  { x: 472, label: 'line layout' },
  { x: 604, label: 'fragmentation' },
  { x: 744, label: 'pages' },
];
---

<div class="scroller">
  <svg viewBox="0 0 980 200" role="img" aria-labelledby="pipeline-title">
    <title id="pipeline-title">
      Content tree and CSS enter; style tree, box tree, line layout,
      fragmentation and pages follow in order; pages leave as a display
      list for preview and a PDF for export.
    </title>

    <g class="node">
      <rect x="8" y="34" width="132" height="34" rx="8"></rect>
      <text x="74" y="56">content tree</text>
    </g>
    <g class="node">
      <rect x="8" y="112" width="132" height="34" rx="8"></rect>
      <text x="74" y="134">CSS</text>
    </g>

    <path class="wire" d="M140 51 H188 Q196 51 196 59 V82 Q196 90 204 90 H224"></path>
    <path class="wire" d="M140 129 H188 Q196 129 196 121 V98 Q196 90 204 90 H224"></path>

    {
      stages.map((stage, i) => (
        <g class="node">
          <rect x={stage.x} y={73} width={stage.label.length * 7.6 + 30} height={34} rx={8} />
          <text x={stage.x + (stage.label.length * 7.6 + 30) / 2} y={95}>
            {stage.label}
          </text>
          {i < stages.length - 1 && (
            <path
              class="wire"
              d={`M${stage.x + stage.label.length * 7.6 + 30} 90 H${stages[i + 1]!.x - 6}`}
            />
          )}
        </g>
      ))
    }

    <path class="wire" d="M828 90 H860 Q868 90 868 82 V48 Q868 40 876 40 H896"></path>
    <path class="wire" d="M828 90 H860 Q868 90 868 98 V132 Q868 140 876 140 H896"></path>

    <g class="node out">
      <rect x="836" y="23" width="136" height="34" rx="8"></rect>
      <text x="904" y="45">display list</text>
    </g>
    <g class="node out">
      <rect x="836" y="123" width="136" height="34" rx="8"></rect>
      <text x="904" y="145">PDF</text>
    </g>
  </svg>
</div>

<style>
  .scroller {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  svg {
    display: block;
    min-width: 46rem;
    width: 100%;
    height: auto;
  }

  .node rect {
    fill: var(--f-glass-solid);
    stroke: var(--f-hairline-strong);
    stroke-width: 1;
  }

  .node.out rect {
    stroke: color-mix(in oklab, var(--f-accent) 55%, transparent);
  }

  .node text {
    fill: var(--f-text);
    font-family: var(--f-mono);
    font-size: 13px;
    text-anchor: middle;
  }

  .wire {
    fill: none;
    stroke: var(--f-hairline-strong);
    stroke-width: 1.25;
  }
</style>
