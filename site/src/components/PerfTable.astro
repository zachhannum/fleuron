---
// The numbers the perf gate holds the engine to. The gate binary
// reproduces them; CI reports them on every pull request.
const rows = [
  {
    book: 'Pride and Prejudice',
    pages: '333',
    cells: ['1 ms', '128 ms', '5 ms', '150 ms', '283 ms', '12 MiB'],
  },
  {
    book: 'The Count of Monte Cristo',
    pages: '1240',
    cells: ['5 ms', '502 ms', '19 ms', '561 ms', '1.08 s', '46 MiB'],
  },
];
const heads = [
  'style',
  'line layout',
  'fragment',
  'PDF',
  'end to end',
  'layout peak',
];
---

<div class="scroller f-glass">
  <table>
    <caption class="sr-only">
      Stage timings and peak layout memory for two public-domain novels.
    </caption>
    <thead>
      <tr>
        <th scope="col">book</th>
        <th scope="col">pages</th>
        {heads.map((h) => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.book}</th>
            <td>{row.pages}</td>
            {row.cells.map((c) => (
              <td>{c}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="note">
  Apple M-series, release build, best of three. Four times the book costs
  about four times the time and four times the memory.
</p>

<style>
  .scroller {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  caption {
    text-align: start;
  }

  th,
  td {
    padding: 0.7rem 1rem;
    text-align: end;
    white-space: nowrap;
  }

  thead th {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--f-text-muted);
    border-bottom: 1px solid var(--f-hairline);
  }

  tbody th {
    font-family: var(--f-display);
    font-size: 1.05rem;
    font-weight: 500;
    font-style: italic;
    text-align: start;
    color: var(--f-text);
  }

  thead th:first-child {
    text-align: start;
  }

  tbody td {
    font-family: var(--f-mono);
    color: var(--f-text);
    font-variant-numeric: tabular-nums;
  }

  tbody tr + tr th,
  tbody tr + tr td {
    border-top: 1px solid var(--f-hairline);
  }

  .note {
    margin: 0.9rem 0 0;
    font-size: 0.8125rem;
    color: var(--f-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
