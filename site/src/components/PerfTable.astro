---
// The numbers the perf gate checks the engine against. The gate binary
// reproduces them; CI reports them on every pull request.
const rows = [
  {
    book: 'Pride and Prejudice',
    pages: '333',
    cells: ['1 ms', '1 ms', '128 ms', '5 ms', '150 ms', '287 ms', '12 MiB'],
  },
  {
    book: 'The Count of Monte Cristo',
    pages: '1254',
    cells: ['5 ms', '6 ms', '505 ms', '20 ms', '563 ms', '1.10 s', '47 MiB'],
  },
];
const heads = [
  'parse',
  'style',
  'line layout',
  'fragment',
  'PDF',
  'end to end',
  'layout peak',
];
---

<div class="scroller">
  <table>
    <caption class="sr-only">
      Stage timings and peak layout memory for two public-domain novels.
    </caption>
    <thead>
      <tr>
        <th scope="col">book</th>
        <th scope="col">pages</th>
        {heads.map((h) => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.book}</th>
            <td>{row.pages}</td>
            {row.cells.map((c) => (
              <td>{c}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="note">
  Apple M-series, release build, best of three. Four times the book costs
  about four times the time and four times the memory.
</p>

<style>
  .scroller {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-family: var(--f-chrome);
    font-size: 0.82rem;
  }

  caption {
    text-align: start;
  }

  th,
  td {
    padding: 0.7rem 0.9rem;
    border: 3px solid var(--f-rule);
    text-align: end;
    white-space: nowrap;
  }

  thead th {
    background: var(--f-rule);
    color: var(--f-ground);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  thead th:first-child {
    text-align: start;
  }

  tbody th {
    background: var(--f-panel);
    color: var(--f-panel-ink);
    font-family: var(--f-display);
    font-variation-settings: var(--f-display-var);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-align: start;
  }

  tbody td {
    background: var(--f-panel);
    color: var(--f-panel-ink);
    font-variant-numeric: tabular-nums;
  }

  /* The memory figure is the one the budgets are written against. */
  tbody td:last-child {
    background: var(--f-hi);
    color: var(--f-hi-ink);
  }

  .note {
    margin: 0.9rem 0 0;
    font-family: var(--f-chrome);
    font-size: 0.72rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
