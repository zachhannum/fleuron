---
import '../styles/theme.css';
import { Code } from 'astro:components';
import Consumers from '../components/Consumers.astro';
import Playground from '../components/demos/Playground.astro';
import bricolage from '../assets/fonts/bricolage-subset.woff2';
import fleuronMixed from '../assets/fonts/fleuron-mixed-subset.woff2';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/zachhannum/fleuron';

// A page design in the supported subset, shown as-is.
const pageCss = `@page {
  size: 5.5in 8.5in;
  margin: 0.8in 0.7in;

  @bottom-center {
    content: counter(page);
  }
}

@page :left {
  @top-left {
    content: "Pride and Prejudice";
  }
}

section {
  break-before: recto;
}

p {
  orphans: 2;
  widows: 2;
}`;
const description =
  'A typesetting engine for novels, in Rust. It turns a manuscript ' +
  'into a book: justified, hyphenated text, running heads, page ' +
  'numbers, and a PDF. Built for markdown writing tools.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>fleuron: a typesetting engine for novels</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://fleuron.typeworks.dev/" />
    <meta property="og:title" content="fleuron" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- The face the display type is set in, and the flowered cut the
         headline opens on. Nothing else on the critical path waits on
         the network. -->
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={fleuronMixed}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- The theme the reader chose, under the key the docs keep it in,
         stamped before the first paint. Left unset, the page follows
         the system. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch (e) {}
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="f-bar"><i></i><i></i><i></i><i></i></div>

    <div class="wrap">
      <header class="nav">
        <a class="brand" href={`${base}/`}>
          <span>fleuron</span>
          <span class="f-mark" aria-hidden="true">&#10086;</span>
        </a>
        <nav aria-label="Primary">
          <a href={`${base}/overview/`}>Docs</a>
          <a href={`${base}/api/fleuron/`}>API</a>
          <a href={repo}>GitHub</a>
          <!-- Revealed by the script that gives it something to do. -->
          <button class="flip" type="button" hidden>Theme</button>
        </nav>
      </header>
    </div>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow f-eyebrow">CSS paged media, in Rust</p>
          <h1><span class="ini">A</span> typesetting engine<br />for novels.</h1>
          <p class="lede">
            fleuron turns a manuscript into a typeset book and renders it
            as a print ready PDF. Styling is CSS. It is built for markdown
            writing tools. Test it out in the playground below.
          </p>
          <div class="cta">
            <a class="button primary" href={`${base}/install/`}>Get started</a>
            <a class="button" href={repo}>Read the source</a>
          </div>
        </div>
      </section>

      <section class="stage">
        <div class="wrap">
          <Playground demo="playground" />
          <p class="stage-note">
            <b>Fleuron playground.</b> Change the manuscript
            or the stylesheet and watch the book update in real time.
          </p>
        </div>
      </section>

      <section class="band">
        <div class="wrap two-up">
          <div>
            <h2>Paged media</h2>
            <p>
              A built-in stylesheet sets the defaults and yours overrides
              whatever you want to change. fleuron supports a <a
                href={`${base}/css-subset/`}>subset of CSS</a>, and reports
              what it does not. Use CSS to configure all the furnishings of
              a professionally typeset novel: trim size, drop caps, page numbers,
              running heads, and much more.
            </p>
          </div>
          <div class="page-css">
            <Code code={pageCss} lang="css" theme="github-dark-default" />
          </div>
        </div>
      </section>

      <section class="band bright">
        <div class="wrap">
          <h2>Performance</h2>
          <p class="section-lede">
            fleron is built for speed. Two complete novels, measured from markdown to PDF.
          </p>
          <div class="speed">
            <table>
              <caption class="sr-only">
                Layout time and peak memory for two public-domain novels.
              </caption>
              <thead>
                <tr>
                  <th scope="col">book</th>
                  <th scope="col">pages</th>
                  <th scope="col">to PDF</th>
                  <th scope="col">peak memory</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Pride and Prejudice</th>
                  <td>333</td>
                  <td>287&nbsp;ms</td>
                  <td>12&nbsp;MiB</td>
                </tr>
                <tr>
                  <th scope="row">The Count of Monte Cristo</th>
                  <td>1254</td>
                  <td>1.10&nbsp;s</td>
                  <td>47&nbsp;MiB</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="speed-note">
            Apple M-series. <a href={`${base}/demos/`}>Run it on yours</a>.
          </p>
        </div>
      </section>

      <section class="band">
        <div class="wrap">
          <h2>Using it</h2>
          <!-- Inline tags stay mid-line: a newline touching one is dropped
               rather than collapsed to a space, which runs the words together. -->
          <p class="section-lede">
            <code>fleuron</code> is the typesetting engine, pure Rust with no I/O.
            <code>fleuron-markdown</code> reads a manuscript into the content
            tree. <code>fleuron-cli</code> takes a manuscript and
            stylesheets and writes a PDF. <code>fleuron-wasm</code> runs the
            same pipeline in a worker.
          </p>
          <Consumers />
        </div>
      </section>

      <section class="band closing">
        <div class="wrap">
          <p class="f-mark closing-mark" aria-hidden="true">&#10086;</p>
          <p class="section-lede center">
            fleuron is pre-alpha. It is being built as the pagination backend
            for <a href="https://github.com/zachhannum/obsidian-orca">Orca</a>,
            an Obsidian plugin for writing novels.
          </p>
          <div class="cta center">
            <a class="button primary" href={`${base}/install/`}>Install fleuron</a>
            <a class="button" href={`${base}/overview/`}>Read the docs</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <p>
          Dual-licensed under Apache-2.0 or MIT.
        </p>
        <p><a href={repo}>github.com/zachhannum/fleuron</a></p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var flip = document.querySelector('.flip');
        function now() {
          if (root.dataset.theme === 'light' || root.dataset.theme === 'dark') {
            return root.dataset.theme;
          }
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function say() {
          flip.setAttribute(
            'aria-label',
            now() === 'dark' ? 'Switch to the light theme' : 'Switch to the dark theme',
          );
        }
        flip.hidden = false;
        say();
        flip.addEventListener('click', function () {
          var next = now() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('starlight-theme', next);
          } catch (e) {}
          say();
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    border: 3px solid var(--f-rule);
    background: var(--f-ground);
    color: var(--f-ink);
    font-family: var(--f-chrome);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .skip:focus {
    left: 0;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 3px solid var(--f-rule);
    font-family: var(--f-chrome);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    font-family: var(--f-display);
    font-variation-settings: var(--f-display-var);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    color: var(--f-ink);
    text-decoration: none;
  }

  .brand .f-mark {
    font-size: 1.2rem;
  }

  .nav nav {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.25rem;
  }

  .nav nav a {
    padding-bottom: 2px;
    border-bottom: 3px solid transparent;
    color: var(--f-ink);
    text-decoration: none;
  }

  .nav nav a:hover {
    border-bottom-color: var(--f-ink-c);
  }

  .flip {
    padding: 0.3rem 0.55rem;
    border: 2px solid var(--f-rule);
    background: transparent;
    color: var(--f-ink);
    font: inherit;
    font-family: var(--f-chrome);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .flip:hover {
    background: var(--f-hi);
    color: var(--f-hi-ink);
    border-color: var(--f-hi-ink);
  }

  .wrap {
    width: min(78rem, 100%);
    margin-inline: auto;
    padding-inline: clamp(1.2rem, 4vw, 3rem);
  }

  .hero {
    width: min(78rem, 100%);
    margin-inline: auto;
    padding-inline: clamp(1.2rem, 4vw, 3rem);
    padding-block: clamp(1.8rem, 4vw, 2.9rem) 1.6rem;
  }

  /* The demo is the hero image, so it gets the width the page has
     and the copy above it keeps a reading measure. */
  .stage {
    padding-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .stage-note {
    margin: 1.1rem 0 0;
    font-family: var(--f-chrome);
    font-size: 0.76rem;
    line-height: 1.7;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stage-note b {
    background: var(--f-hi);
    color: var(--f-hi-ink);
    padding: 0.1rem 0.35rem;
    font-weight: 700;
  }

  .eyebrow {
    margin: 0 0 1.3rem;
  }

  /* The plates, out of register. Both ghosts are process inks, so the
     headline reads the same way on either ground. */
  h1 {
    margin: 0;
    max-width: 17ch;
    font-family: var(--f-display);
    font-variation-settings: var(--f-display-var);
    font-weight: 600;
    font-size: clamp(2.5rem, 7vw, 5.8rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--f-ink);
    text-shadow:
      var(--f-gx) var(--f-gy) 0 var(--f-ink-c),
      calc(var(--f-gx) * -0.8) calc(var(--f-gy) * -0.8) 0 var(--f-ink-m);
    /* Room for the initial to hang its flowers into. */
    padding-left: 0.08em;
    margin-left: -0.08em;
  }

  /* One cut weight in this face. Left to inherit the headline's 600
     the browser fakes the bold, and the glyph is dense enough. */
  h1 .ini {
    font-family: var(--f-display-ini);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .lede {
    max-width: 48ch;
    margin: 1.4rem 0 0;
    font-size: 1.02rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .cta.center {
    justify-content: center;
  }

  .button {
    display: inline-block;
    padding: 0.78rem 1.3rem;
    border: 3px solid var(--f-rule);
    background: var(--f-btn-bg);
    color: var(--f-ink);
    box-shadow: 6px 6px 0 var(--f-rule);
    font-family: var(--f-chrome);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .button:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--f-rule);
  }

  .button.primary {
    background: var(--f-btn-p-bg);
    color: var(--f-btn-p-ink);
    box-shadow: 6px 6px 0 var(--f-btn-p-shadow);
  }

  .button.primary:hover {
    box-shadow: 3px 3px 0 var(--f-btn-p-shadow);
  }

  @media (prefers-reduced-motion: reduce) {
    .button:hover {
      transform: none;
    }
  }

  .band {
    padding-block: clamp(2rem, 4.5vw, 3.2rem);
    border-top: 3px solid var(--f-rule);
  }

  /* The performance band is a full-bleed cyan panel in both themes,
     so the numbers land on one ground wherever they are read. */
  .band.bright {
    background: var(--f-bright-bg);
    color: var(--f-bright-ink);
  }

  .band h2 {
    margin: 0 0 1rem;
    font-family: var(--f-display);
    font-variation-settings: var(--f-display-var);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: inherit;
  }

  .section-lede {
    max-width: 52ch;
    margin: 0 0 1.5rem;
    font-size: 0.98rem;
    line-height: 1.55;
    font-weight: 500;
  }

  .section-lede.center {
    margin-inline: auto;
  }

  .section-lede code {
    font-family: var(--f-chrome);
    font-size: 0.86em;
    font-weight: 700;
  }

  main a:not(.button) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--f-ink-m);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .band.bright a:not(.button) {
    text-decoration-color: var(--f-bright-ink);
  }

  .two-up {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* The column has a code block in it that scrolls, which needs a
     track free to be narrower than the code in it. */
  .two-up > * {
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .two-up {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .two-up p {
    max-width: 52ch;
    font-size: 0.98rem;
    line-height: 1.55;
    font-weight: 500;
  }

  .two-up p code {
    font-family: var(--f-chrome);
    font-size: 0.86em;
    font-weight: 700;
  }

  .page-css :global(pre) {
    margin: 0;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    border: 3px solid var(--f-rule);
    background: var(--f-code-bg) !important;
    box-shadow: 10px 10px 0 var(--f-box-shadow);
    font-family: var(--f-chrome);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .speed {
    overflow-x: auto;
  }

  .speed table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-family: var(--f-chrome);
    font-size: 0.82rem;
  }

  .speed caption {
    text-align: start;
  }

  .speed th,
  .speed td {
    padding: 0.7rem 0.9rem;
    border: 3px solid var(--f-rule);
    text-align: end;
    white-space: nowrap;
  }

  .speed thead th {
    background: var(--f-rule);
    color: var(--f-ground);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .speed thead th:first-child {
    text-align: start;
  }

  .speed tbody th {
    background: var(--f-panel);
    color: var(--f-panel-ink);
    font-family: var(--f-display);
    font-variation-settings: var(--f-display-var);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-align: start;
  }

  .speed tbody td {
    background: var(--f-panel);
    color: var(--f-panel-ink);
    font-variant-numeric: tabular-nums;
  }

  /* The memory figure is the one the budgets are written against. */
  .speed tbody td:last-child {
    background: var(--f-hi);
    color: var(--f-hi-ink);
  }

  .speed-note {
    margin: 0.9rem 0 0;
    font-family: var(--f-chrome);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .closing {
    text-align: center;
  }

  .closing .section-lede {
    text-align: center;
  }

  .closing-mark {
    margin: 0 0 1.5rem;
    font-size: 2.5rem;
  }

  .foot {
    padding-block: 1.4rem;
    border-top: 3px solid var(--f-rule);
    background: var(--f-foot-bg);
    color: var(--f-foot-ink);
    font-family: var(--f-chrome);
    font-size: 0.72rem;
  }

  .foot .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
  }

  .foot p {
    margin: 0;
  }

  .foot a {
    color: inherit;
    text-decoration-color: var(--f-ink-m);
  }
</style>
