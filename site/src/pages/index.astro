---
import '../styles/theme.css';
import Consumers from '../components/Consumers.astro';
import HeroPage from '../components/HeroPage.astro';
import PerfTable from '../components/PerfTable.astro';
import Pipeline from '../components/Pipeline.astro';
import garamond from '../assets/fonts/ebgaramond-subset.woff2';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/zachhannum/fleuron';
const description =
  'A paged-media layout engine for book-shaped documents, in Rust. ' +
  'Shaping, line breaking, hyphenation, fragmentation, and a display ' +
  'list a PDF and a preview are both painted from.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>fleuron — paged-media layout for books, in Rust</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://zachhannum.github.io/fleuron/" />
    <meta property="og:title" content="fleuron" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- The face the display type is set in. Nothing else on the
         critical path waits on the network. -->
    <link
      rel="preload"
      href={garamond}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav f-chrome">
      <a class="brand" href={`${base}/`}>
        <span class="f-mark" aria-hidden="true">&#10086;</span>
        <span>fleuron</span>
      </a>
      <nav aria-label="Primary">
        <a href={`${base}/overview/`}>Docs</a>
        <a href={`${base}/api/fleuron/`}>API</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Paged media, owned end to end</p>
          <h1>A book is not a<br />very long web page.</h1>
          <p class="lede">
            fleuron takes structured content plus CSS, shapes and breaks the
            lines itself, fragments the flow into pages, and emits one display
            list that a PDF and a preview are both painted from. Native and
            WebAssembly, from the same core.
          </p>
          <div class="cta">
            <a class="button primary" href={`${base}/install/`}>Get started</a>
            <a class="button" href={repo}>Read the source</a>
          </div>
          <p class="claim">
            <strong>333 pages in 283&nbsp;ms.</strong> A measurement, not an
            adjective &mdash; and CI holds it there.
          </p>
        </div>
        <div class="hero-page">
          <HeroPage />
        </div>
      </section>

      <section class="band f-dots">
        <div class="wrap">
          <h2>One way through</h2>
          <p class="section-lede">
            Content enters as a semantic tree, styling enters as CSS, and
            nothing downstream reaches back upstream. Break decisions fall out
            of the layout pass rather than being guessed at through a DOM.
          </p>
          <Pipeline />
        </div>
      </section>

      <section class="band">
        <div class="wrap">
          <h2>Three ways in</h2>
          <p class="section-lede">
            The same job &mdash; a content tree and a stylesheet become a PDF
            &mdash; cut for the three people who ask for it.
          </p>
          <Consumers />
        </div>
      </section>

      <section class="band">
        <div class="wrap">
          <h2>The numbers</h2>
          <p class="section-lede">
            The harness lays out two complete public-domain novels and holds
            the result against fixed ceilings. Pride and Prejudice is the gate;
            The Count of Monte Cristo is four times it, and exists to expose
            superlinearity.
          </p>
          <PerfTable />
        </div>
      </section>

      <section class="band">
        <div class="wrap two-up">
          <div>
            <h2>Why this exists</h2>
            <p>
              Browser-based pagination asks the layout engine <em
                >did it overflow?</em
              > thousands of times per book, and pays for a full layout each answer.
              That is the cost model, and no amount of care around it changes the
              shape of the curve.
            </p>
            <p>
              fleuron owns the whole pipeline instead: harfrust shaping, Unicode
              line breaking and segmentation, justification by total fit, and CSS
              Fragmentation semantics applied to a box tree it builds itself. The
              result is book-scale pagination in hundreds of milliseconds rather
              than minutes, and a preview that is <em>exactly</em> the export, because
              both are painted from the same display list.
            </p>
          </div>
          <aside class="f-glass invariants">
            <h3>Three invariants</h3>
            <ol>
              <li>
                <strong>Styling enters as CSS.</strong> A built-in user-agent sheet
                supplies the defaults; author CSS cascades over it. Anything outside
                the supported subset is reported with the line and column it was
                written at.
              </li>
              <li>
                <strong>The engine never touches the DOM.</strong> Bytes in, bytes
                out. SVG, canvas and PDF are interchangeable painters over one display
                list.
              </li>
              <li>
                <strong>Layout never decodes images.</strong> Header probes yield
                intrinsic size, orientation and DPI; painters decode pixels on their
                own side of the wall.
              </li>
            </ol>
          </aside>
        </div>
      </section>

      <section class="band closing">
        <div class="wrap">
          <p class="f-mark closing-mark" aria-hidden="true">&#10086;</p>
          <p class="section-lede center">
            Pre-alpha, and honest about it. The build order lives in the issue
            tracker; the documentation says plainly which parts have landed.
          </p>
          <div class="cta center">
            <a class="button primary" href={`${base}/install/`}>Install fleuron</a>
            <a class="button" href={`${base}/css-subset/`}>The CSS subset</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <p>
          Dual-licensed under Apache-2.0 or MIT. Set in EB Garamond, the face
          the engine ships.
        </p>
        <p><a href={repo}>github.com/zachhannum/fleuron</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--f-raise);
    color: var(--f-text);
  }

  .skip:focus {
    left: 0;
  }

  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--f-text);
    text-decoration: none;
  }

  .brand .f-mark {
    font-size: 1.3rem;
  }

  .nav nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }

  .nav nav a {
    font-size: 0.875rem;
    color: var(--f-text-muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--f-text);
  }

  main {
    padding-top: 4rem;
  }

  .wrap {
    width: min(72rem, 100% - clamp(2rem, 8vw, 6rem));
    margin-inline: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
    width: min(72rem, 100% - clamp(2rem, 8vw, 6rem));
    margin-inline: auto;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 7vw, 6rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--f-text-muted);
  }

  h1 {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(2.8rem, 1.6rem + 4.6vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--f-text);
  }

  .lede {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--f-text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .cta.center {
    justify-content: center;
  }

  .button {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--f-hairline-strong);
    border-radius: 999px;
    font-size: 0.9375rem;
    color: var(--f-text);
    text-decoration: none;
    background: var(--f-glass-solid);
  }

  .button:hover {
    border-color: var(--f-text-faint);
  }

  .button.primary {
    background: var(--f-accent-deep);
    border-color: var(--f-accent-deep);
    color: #ffffff;
    font-weight: 500;
  }

  .button.primary:hover {
    filter: brightness(1.1);
  }

  .claim {
    margin: 2rem 0 0;
    font-size: 0.9375rem;
    color: var(--f-text-muted);
  }

  .claim strong {
    color: var(--f-text);
  }

  .band {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--f-hairline);
  }

  .band h2 {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--f-text);
  }

  .section-lede {
    max-width: 44rem;
    margin: 1rem 0 2.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--f-text-muted);
  }

  .section-lede.center {
    margin-inline: auto;
    text-align: center;
  }

  .two-up {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .two-up {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .two-up p {
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--f-text-muted);
  }

  .invariants {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .invariants h3 {
    margin: 0 0 1rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--f-text-muted);
  }

  .invariants ol {
    margin: 0;
    padding-inline-start: 1.2rem;
    display: grid;
    gap: 1rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--f-text-muted);
  }

  .invariants strong {
    color: var(--f-text);
  }

  .closing {
    text-align: center;
  }

  .closing-mark {
    margin: 0 0 1.5rem;
    font-size: 2.5rem;
  }

  .foot {
    padding-block: 2.5rem 4rem;
    border-top: 1px solid var(--f-hairline);
    font-size: 0.8125rem;
    color: var(--f-text-muted);
  }

  .foot .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
  }

  .foot p {
    margin: 0;
  }

  .foot a {
    color: var(--f-text-muted);
  }

  em {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.08em;
    color: var(--f-text);
  }
</style>
